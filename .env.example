# Supabase Realtime, used from M4 onward for invite-link rooms.
# Create a free project at supabase.com, then copy these from
# Project Settings -> API. Set the same two values in the Vercel dashboard
# under Settings -> Environment Variables.
#
# The anon key is PUBLIC by design and ships in the client bundle.
# The service_role key must never appear in this repo.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
